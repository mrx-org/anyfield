# OpenAI-compatible LLM (e.g. llama.cpp --alias local)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local
LLM_API_KEY=local

# JSON object passed to chat.completions.create (temperature, max_tokens, top_p, …)
LLM_GENERATION={"temperature": 0.3}

# Max select/context-update rounds per user message (client agent loop, via GET /health)
CHAT_MAX_AGENT_LOOPS=3

# Anyfield static app origin (http.server default); used for CORS when CORS_ORIGINS unset
ANYFIELD_FRONTEND_URL=http://localhost:8000
# Comma-separated allowed browser origins (defaults to ANYFIELD_FRONTEND_URL + http://127.0.0.1:8000)
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# FastAPI bind
CHAT_HOST=127.0.0.1
CHAT_PORT=8765

# Logging (full messages at DEBUG)
LOG_LEVEL=DEBUG
LOG_FILE=logs/chat.log
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=3
