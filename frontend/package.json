{
  "name": "anyfield-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --silent --no-emit-readme --no-emit-prettier-ignore",
    "dev": "pnpm i18n && vite",
    "build": "pnpm i18n && vite build && node scripts/build-apps.mjs",
    "check": "pnpm i18n && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm i18n && vitest run"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@lucide/svelte": "^1.77.0",
    "@skeletonlabs/skeleton": "^5.0.4",
    "@skeletonlabs/skeleton-svelte": "^5.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@niivue/niivue": "^0.69.0",
    "codemirror": "^6.0.2",
    "dockview": "8.10.0"
  },
  "packageManager": "pnpm@10.28.0"
}
